#include<iostream>
using namespace std;

int main () {
    int grade;
    int student = 1;
    int passed = 0;
    int failed = 0;
    
    while (student <= 10) {
        cout << "Enter grade of student:" << student << endl;
        cout << "Grade:";
        cin >> grade;
        
        if (grade <= 75) {
            student++;
            passed++;
            
        } else {
            failed++;
            student++;
        }
    }
        
        cout << "Number of students who passed:" << passed << endl;
        cout << "Number of students who failed:" << failed;
        
        return 0;
}
